#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Detect and mount external drives, then generate Samba config
# ==============================================================================

# ---- OS / protection checks ----
if ! [[ "$(bashio::info.operating_system)" =~ ^Home\ Assistant\ OS.* ]]; then
    bashio::exit.nok "Mount It requires Home Assistant OS (got: $(bashio::info.operating_system))"
fi
if $(bashio::addon.protected); then
    bashio::exit.nok "Disable Protection Mode in addon settings to allow drive mounting"
fi

echo "{}" > /tmp/mountit_mounts.json
mkdir -p /mnt

# ---- Samba service account ----
PASSWORD=$(sed 's/[-]//g' /proc/sys/kernel/random/uuid | head -c 20)
(umask 077; echo "$PASSWORD" > /tmp/mountit_password)
(echo "$PASSWORD"; echo "$PASSWORD") | smbpasswd -a -s _mountit_ 2>/dev/null \
    || (echo "$PASSWORD"; echo "$PASSWORD") | smbpasswd -s _mountit_ 2>/dev/null \
    || bashio::log.warning "Could not set Samba password — HA registration may fail"

# ---- Config ----
specific_label=$(bashio::config 'specific_label' 2>/dev/null || echo "")
mount_location=$(bashio::config 'mount_location')

addon_ip=$(bashio::addon.ip_address 2>/dev/null || echo "")
addon_ip="${addon_ip/\/*/}"
echo "$addon_ip" > /tmp/mountit_ip

bashio::log.blue "Configuration"
bashio::log.info "  mount_unlabeled:     $(bashio::config 'mount_unlabeled')"
bashio::log.info "  automount_on_plugin: $(bashio::config 'automount_on_plugin')"
bashio::log.info "  specific_label:      ${specific_label:-(any)}"
bashio::log.info "  mount_location:      $mount_location"
bashio::log.info "  hdd_idle_seconds:    $(bashio::config 'hdd_idle_seconds')"
bashio::log.info "  samba bind address:  ${addon_ip:-(all interfaces)}"

# ---- File activity auditing (Samba full_audit VFS module) ----
# Migrate the previous toggle/detail pair without unexpectedly enabling logging
# for users whose File Activity Log toggle was off.
audit_detail=$(bashio::config 'file_activity_detail' 2>/dev/null || echo "off")
if ! addon_options=$(bashio::addon.options 2>/dev/null); then
    audit_detail="off"
    bashio::log.warning "  file_activity_detail: off — could not inspect legacy settings"
elif bashio::jq.exists "$addon_options" ".file_activity_log"; then
    legacy_file_activity_log=$(jq -r '.file_activity_log' <<< "$addon_options")
    if [[ "$legacy_file_activity_log" == "true" ]]; then
        [[ "$audit_detail" == "basic" || "$audit_detail" == "detailed" ]] \
            || audit_detail="basic"
    else
        audit_detail="off"
    fi

    migrated_options=$(jq -c --arg detail "$audit_detail" \
        'del(.file_activity_log) | .file_activity_detail = $detail' \
        <<< "$addon_options")
    bashio::addon.options 'self' "$migrated_options" > /dev/null \
        && bashio::log.info "  Migrated legacy file activity settings" \
        || bashio::log.warning "Could not migrate legacy file activity settings"
fi

# An operation name full_audit does not recognise makes it refuse every share
# connection, and the *at names below only exist on Samba 4.14+ (which replaced
# open/rename/unlink/mkdir/rmdir), so verify the version before enabling.
audit_ops=""
case "$audit_detail" in
    off)
        bashio::log.info "  file_activity_detail: off" ;;
    basic|detailed)
        samba_version=$(smbd --version 2>/dev/null | sed -n 's/^Version \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p')
        samba_major="${samba_version%%.*}"
        samba_minor="${samba_version#*.}"

        if [[ -z "$samba_version" ]] || (( samba_major < 4 || (samba_major == 4 && samba_minor < 14) )); then
            bashio::log.warning "  file_activity_detail: off — '$audit_detail' needs Samba 4.14+ (found ${samba_version:-unknown})"
        elif [[ "$audit_detail" == "detailed" ]]; then
            audit_ops="connect disconnect create_file close renameat unlinkat mkdirat"
            audit_ops="$audit_ops ftruncate fchmod fchown fsetxattr fset_nt_acl pread pwrite"
            bashio::log.info "  file_activity_detail: detailed"
        else
            audit_ops="connect disconnect create_file renameat unlinkat mkdirat"
            bashio::log.info "  file_activity_detail: basic"
        fi ;;
    *)
        audit_detail="off"
        bashio::log.warning "  file_activity_detail: off — invalid configured value" ;;
esac

folder_mount_count=$(jq '.folder_mounts | length' /data/options.json 2>/dev/null || echo "0")
if [[ "$folder_mount_count" -gt 0 ]]; then
    bashio::log.info "  folder_mounts:"
    for i in $(seq 0 $((folder_mount_count - 1))); do
        name=$(jq -r ".folder_mounts[$i].name // empty" /data/options.json)
        drive=$(jq -r ".folder_mounts[$i].drive"    /data/options.json)
        folder=$(jq -r ".folder_mounts[$i].folder"  /data/options.json)
        location=$(jq -r ".folder_mounts[$i].location" /data/options.json)
        bashio::log.info "    [$i] $drive/$folder → $location (name: ${name:-(automatic)})"
    done
else
    bashio::log.info "  folder_mounts:       (none)"
fi

# ---- Drive discovery ----
bashio::log.blue "Scanning drives"

lsblk -o NAME,LABEL,FSTYPE,SIZE,TYPE 2>/dev/null | while IFS= read -r line; do
    bashio::log.info "  $line"
done

readarray -t labeled_drives < <(poetry -C /usr/local/bin/ run python /usr/local/bin/detect_drives.py 2>/tmp/detect_drives.err)

if [[ ${#labeled_drives[@]} -eq 0 ]]; then
    bashio::log.info "  No labeled drives found"
    if [[ -s /tmp/detect_drives.err ]]; then
        bashio::log.warning "  detect_drives.py stderr: $(head -c 500 /tmp/detect_drives.err | tr '\n' ';')"
    fi
else
    bashio::log.info "  Labeled drives: ${labeled_drives[*]}"
fi

if bashio::config.true 'mount_unlabeled'; then
    while IFS= read -r devname; do
        label=$(lsblk "$devname" -no LABEL 2>/dev/null | tr -d '[:space:]')
        fstype=$(lsblk "$devname" -no FSTYPE 2>/dev/null | tr -d '[:space:]')
        [[ -z "$fstype" || "$label" == hassos* ]] && continue
        if [[ -z "$label" ]]; then
            shortname="unlabeled_$(basename "$devname")"
            echo "$devname" > "/tmp/devmap_${shortname}"
            labeled_drives+=("$shortname")
            bashio::log.info "  Unlabeled: $devname → $shortname [$fstype]"
        fi
    done < <(lsblk -npro NAME,TYPE 2>/dev/null | awk '$2=="part"{print $1}')
fi

if [[ -n "$specific_label" && "$specific_label" != "null" ]]; then
    filtered_drives=()
    for d in "${labeled_drives[@]}"; do
        [[ "$d" == "$specific_label" ]] && filtered_drives+=("$d") || bashio::log.info "  Skipped (not '$specific_label'): $d"
    done
    drives_to_mount=("${filtered_drives[@]}")
else
    drives_to_mount=("${labeled_drives[@]}")
fi

if [[ ${#drives_to_mount[@]} -eq 0 ]]; then
    bashio::log.warning "No drives to mount"
fi

# ---- Mount ----
mount_drive() {
    local disk="$1"
    local dev fstype options="nosuid,relatime" type="auto" cmd="mount"
    # HA Supervisor mount names must match ^[A-Za-z0-9_]+$
    local mdisk
    mdisk=$(printf '%s' "$disk" | sed 's/[^A-Za-z0-9_]/_/g')

    if [[ "$disk" == unlabeled_* ]]; then
        dev=$(cat "/tmp/devmap_${disk}" 2>/dev/null)
    else
        dev=$(blkid -L "$disk" 2>/dev/null)
        local dup_count
        dup_count=$(blkid -o device -t LABEL="$disk" 2>/dev/null | wc -l)
        if [[ "$dup_count" -gt 1 ]]; then
            bashio::log.warning "  $mdisk — $dup_count partitions share label '$disk', only $dev will be mounted"
        fi
    fi

    if [[ -z "$dev" ]]; then
        bashio::log.warning "Drive '$disk' — device not found, skipping"
        return 1
    fi

    mkdir -p "/mnt/$mdisk"
    chmod a+rwx "/mnt/$mdisk"

    if findmnt -n -o TARGET "/mnt/$mdisk" > /dev/null 2>&1; then
        bashio::log.info "  $mdisk — already mounted"
        jq --arg k "$mdisk" --arg dev "$dev" --arg mp "/mnt/$mdisk" --arg fs "unknown" \
           '. + {($k): {"device":$dev,"mount_point":$mp,"label":$k,"fstype":$fs}}' \
           /tmp/mountit_mounts.json > /tmp/mountit_mounts.json.tmp \
        && mv /tmp/mountit_mounts.json.tmp /tmp/mountit_mounts.json
        return 0
    fi

    fstype=$(lsblk "$dev" -no FSTYPE 2>/dev/null | head -1 | tr -d '[:space:]')

    local m_args=()
    case "$fstype" in
        exfat|vfat|msdos)
            bashio::log.warning "  $mdisk — $fstype (experimental, no ACL support)"
            options="${options},umask=000" ;;
        ntfs)
            options="${options},umask=000"; type="ntfs3" ;;
        apfs)
            bashio::log.warning "  $mdisk — APFS (read-only, experimental)"
            cmd="mount.apfs"; type=""; options="" ;;
    esac

    [[ -n "$type" ]]    && m_args+=("-t" "$type")
    [[ -n "$options" ]] && m_args+=("-o" "$options")
    m_args+=("$dev")

    local mounted=false fix_out=""
    if $cmd "${m_args[@]}" "/mnt/$mdisk"; then
        mounted=true
    elif [[ "$fstype" == "ntfs" ]]; then
        # try clean up NTFS dirty state with ntfsfix
        bashio::log.warning "  $mdisk [ntfs] — mount failed, running ntfsfix..."
        if fix_out=$(ntfsfix -d "$dev" 2>&1); then
            bashio::log.info "  $mdisk — ntfsfix: ${fix_out//$'\n'/; }"
            bashio::log.warning "  $mdisk — NTFS dirty flag cleared without a full repair; if the drive was not safely ejected, verify data with chkdsk on Windows"
            $cmd "${m_args[@]}" "/mnt/$mdisk" && mounted=true
        else
            bashio::log.warning "  $mdisk — ntfsfix failed: ${fix_out//$'\n'/; }"
        fi
    fi

    if $mounted; then
        bashio::log.green "  $mdisk [$fstype] → /mnt/$mdisk"
        jq --arg k "$mdisk" --arg dev "$dev" \
           --arg mp "/mnt/$mdisk" --arg fs "${fstype:-unknown}" \
           '. + {($k): {"device":$dev,"mount_point":$mp,"label":$k,"fstype":$fs}}' \
           /tmp/mountit_mounts.json > /tmp/mountit_mounts.json.tmp \
        && mv /tmp/mountit_mounts.json.tmp /tmp/mountit_mounts.json
    else
        bashio::log.error "  $mdisk [$fstype] — mount failed"
        rmdir "/mnt/$mdisk" 2>/dev/null || true
        return 1
    fi
}

if [[ ${#drives_to_mount[@]} -gt 0 ]]; then
    bashio::log.blue "Mounting"
    for drive in "${drives_to_mount[@]}"; do
        mount_drive "$drive" || true
    done
fi

mounted_count=$(jq 'length' /tmp/mountit_mounts.json)

# ---- Samba config ----
{
cat << 'GLOBAL_END'
[global]
   workgroup = WORKGROUP
   server string = Mount It
   security = user
   map to guest = Never
   load printers = No
   printing = bsd
   printcap name = /dev/null
   disable spoolss = Yes
   ea support = Yes
GLOBAL_END

# full_audit goes last in the chain so it reports the real on-disk path, and so
# NTFS alternate data streams already folded into xattrs by streams_xattr do not
# show up as separate file activity. syslog = No sends the audit trail to smbd's
# own debug output, which the addon log shows (smbd runs with --debug-stdout).
if [[ -n "$audit_ops" ]]; then
    printf '   vfs objects = catia streams_xattr full_audit\n'
    printf '   log level = 0 full_audit:1\n'
    printf '   full_audit:prefix = %%T|%%I|%%S\n'
    printf '   full_audit:success = %s\n' "$audit_ops"
    printf '   full_audit:failure = %s\n' "$audit_ops"
    printf '   full_audit:syslog = No\n'
    printf '   full_audit:log_secdesc = No\n'
    printf '   max log size = 0\n'
else
    printf '   vfs objects = catia streams_xattr\n'
    printf '   log level = 0\n'
fi

if [[ -n "$addon_ip" && "$addon_ip" != "null" ]]; then
    printf '   bind interfaces only = Yes\n'
    printf '   interfaces = %s\n\n' "$addon_ip"
else
    printf '   bind interfaces only = No\n\n'
fi

while IFS= read -r label; do
    mp=$(jq -r --arg l "$label" '.[$l].mount_point' /tmp/mountit_mounts.json)
    printf '[%s]\n' "$label"
    printf '   path = %s\n' "$mp"
    printf '   valid users = _mountit_\n'
    printf '   read only = No\n'
    printf '   guest ok = No\n'
    printf '   force user = root\n'
    printf '   create mask = 0777\n'
    printf '   directory mask = 0777\n\n'
done < <(jq -r 'keys[]' /tmp/mountit_mounts.json 2>/dev/null)

} > /etc/samba/smb.conf

# ---- Folder mounts (subfolder → different HA location) ----
echo "{}" > /tmp/mountit_folder_mounts.json

folder_mount_count=$(jq '.folder_mounts | length' /data/options.json 2>/dev/null || echo "0")

if [[ "$folder_mount_count" -gt 0 ]]; then
    bashio::log.blue "Folder mounts"
    reserved_names="media share backup config addons ssl homeassistant"

    for i in $(seq 0 $((folder_mount_count - 1))); do
        configured_name=$(jq -r ".folder_mounts[$i].name // empty" /data/options.json)
        drive=$(jq -r ".folder_mounts[$i].drive"    /data/options.json)
        folder=$(jq -r ".folder_mounts[$i].folder"  /data/options.json)
        location=$(jq -r ".folder_mounts[$i].location" /data/options.json)

        # Mount keys are sanitized to ^[A-Za-z0-9_]+$; accept the raw label too
        drive_key=$(printf '%s' "$drive" | sed 's/[^A-Za-z0-9_]/_/g')

        # Drive must be mounted
        if ! jq -e --arg d "$drive_key" '.[$d]' /tmp/mountit_mounts.json > /dev/null 2>&1; then
            bashio::log.error "  $drive/$folder — drive '$drive' is not mounted, skipping"
            continue
        fi

        drive_mp=$(jq -r --arg d "$drive_key" '.[$d].mount_point' /tmp/mountit_mounts.json)
        full_path="${drive_mp}/${folder}"

        # Folder must exist
        if [[ ! -d "$full_path" ]]; then
            bashio::log.error "  $drive/$folder — path does not exist ($full_path), skipping"
            continue
        fi

        # Auto-generate Samba share name: drive_sanitized_folder
        folder_clean=$(echo "$folder" | sed 's|[^a-zA-Z0-9]|_|g; s|_\+|_|g; s|^_||; s|_$||')
        share_name="${drive_key}_${folder_clean}"
        mount_name="${configured_name:-$share_name}"

        # HA Supervisor mount names may contain only letters, numbers, and underscores
        if [[ ! "$mount_name" =~ ^[A-Za-z0-9_]+$ ]]; then
            bashio::log.error "  $drive/$folder — network storage name '$mount_name' is invalid, skipping"
            continue
        fi

        # Reserved name check
        for rn in $reserved_names; do
            if [[ "${mount_name,,}" == "${rn,,}" ]]; then
                bashio::log.error "  $drive/$folder — network storage name '$mount_name' is reserved, skipping"
                continue 2
            fi
        done

        # The Samba share must not conflict with an existing drive share
        if jq -e --arg n "$share_name" '.[$n]' /tmp/mountit_mounts.json > /dev/null 2>&1; then
            bashio::log.error "  $drive/$folder — Samba share '$share_name' conflicts with a drive mount, skipping"
            continue
        fi

        # The HA mount name must not conflict with an existing drive mount
        if jq -e --arg n "$mount_name" '.[$n]' /tmp/mountit_mounts.json > /dev/null 2>&1; then
            bashio::log.error "  $drive/$folder — network storage name '$mount_name' conflicts with a drive mount, skipping"
            continue
        fi

        # The HA mount name must be unique across folder mounts
        if jq -e --arg n "$mount_name" '.[$n]' /tmp/mountit_folder_mounts.json > /dev/null 2>&1; then
            bashio::log.error "  $drive/$folder — network storage name '$mount_name' conflicts with another folder mount, skipping"
            continue
        fi

        # The generated Samba share must also be unique across folder mounts
        if jq -e --arg n "$share_name" '.[] | select(.share == $n)' /tmp/mountit_folder_mounts.json > /dev/null 2>&1; then
            bashio::log.error "  $drive/$folder — Samba share '$share_name' conflicts with another folder mount, skipping"
            continue
        fi

        # Append Samba share
        {
            printf '[%s]\n'                    "$share_name"
            printf '   path = %s\n'            "$full_path"
            printf '   valid users = _mountit_\n'
            printf '   read only = No\n'
            printf '   guest ok = No\n'
            printf '   force user = root\n'
            printf '   create mask = 0777\n'
            printf '   directory mask = 0777\n\n'
        } >> /etc/samba/smb.conf

        # Track in state
        jq --arg k "$mount_name" --arg share "$share_name" \
           --arg drive "$drive" --arg folder "$folder" \
           --arg path "$full_path" --arg loc "$location" \
           '. + {($k): {"share":$share,"drive":$drive,"folder":$folder,"path":$path,"location":$loc}}' \
           /tmp/mountit_folder_mounts.json > /tmp/mountit_folder_mounts.json.tmp \
        && mv /tmp/mountit_folder_mounts.json.tmp /tmp/mountit_folder_mounts.json

        bashio::log.green "  $drive/$folder → $mount_name [$share_name] ($location)"
    done
fi

folder_mounted_count=$(jq 'length' /tmp/mountit_folder_mounts.json)

if [[ "$mounted_count" -gt 0 || "$folder_mounted_count" -gt 0 ]]; then
    bashio::log.green "Ready — $mounted_count drive(s), $folder_mounted_count folder mount(s)"
else
    bashio::log.warning "Ready — no drives or folder mounts configured"
fi
