#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Prepare Home Assistant Supervisor network-storage reconciliation
# ==============================================================================

source /usr/local/lib/mountit-supervisor.sh

if ! mountit::init_supervisor_context; then
    bashio::log.error "HA registration is unavailable; background recovery will retry"
    exit 0
fi

drive_count=$(jq 'length' "$MOUNTIT_MOUNTS_FILE" 2>/dev/null || echo 0)
folder_count=$(jq 'length' "$MOUNTIT_FOLDER_MOUNTS_FILE" 2>/dev/null || echo 0)
desired_count=$((drive_count + folder_count))

if ((desired_count > 0)); then
    bashio::log.blue "Reconciling HA network storage  (server=$MOUNTIT_SERVER)"
    bashio::log.info "Waiting for Samba on port 445..."
    if ! bashio::net.wait_for 445 "$MOUNTIT_SERVER" 60; then
        bashio::log.error "Samba did not become ready; background recovery will retry"
        exit 0
    fi
else
    bashio::log.info "No mounted drives to register"
fi

# Keep this s6 oneshot free of long Supervisor mutations so shutdown can never
# wait on an in-progress oneshot. The dependent, signal-aware ha-reconcile
# longrun performs its first pass immediately.
bashio::log.info "Samba is ready; starting HA storage reconciliation"
exit 0
