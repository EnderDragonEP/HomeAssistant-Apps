#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Register mounted drives with the HA Supervisor as CIFS network storage
# ==============================================================================
# shellcheck source=/dev/null
source /usr/lib/mountit/events.sh
# shellcheck source=/dev/null
source /usr/lib/mountit/mounts.sh

if [[ ! -f /tmp/mountit_mounts.json ]] || [[ "$(jq 'length' /tmp/mountit_mounts.json)" -eq 0 ]]; then
    bashio::log.info "No drives to register"
    exit 0
fi

ipaddress=$(cat /tmp/mountit_ip)
usage=$(bashio::config 'mount_location')

bashio::log.blue "Registering with HA  (usage=$usage, server=$ipaddress)"
bashio::log.info "Waiting for Samba on port 445..."
bashio::net.wait_for 445 "$ipaddress" 60

while IFS= read -r label; do
    success=false
    if mountit::mount.register "$label" "$label" "$usage"; then
        bashio::log.green "  $label → $usage"
        success=true
    fi

    mountit::event.queue drive_mounted "$(jq -c --arg n "$label" --arg loc "$usage" \
        --argjson reg "$success" \
        '.[$n] | {"name":$n,"device":.device,"fstype":.fstype,"mount_point":.mount_point,"location":$loc,"registered":$reg,"source":"startup"}' \
        /tmp/mountit_mounts.json)"

done < <(jq -r 'keys[]' /tmp/mountit_mounts.json 2>/dev/null)

# ---- Register folder mounts ----
if [[ -f /tmp/mountit_folder_mounts.json ]] && [[ "$(jq 'length' /tmp/mountit_folder_mounts.json)" -gt 0 ]]; then
    bashio::log.blue "Registering folder mounts"

    while IFS= read -r mount_name; do
        location=$(jq -r --arg n "$mount_name" '.[$n].location' /tmp/mountit_folder_mounts.json)
        drive=$(jq -r --arg n "$mount_name" '.[$n].drive'       /tmp/mountit_folder_mounts.json)
        folder=$(jq -r --arg n "$mount_name" '.[$n].folder'     /tmp/mountit_folder_mounts.json)
        share_name=$(jq -r --arg n "$mount_name" '.[$n].share // $n' /tmp/mountit_folder_mounts.json)

        mountit::mount.register "$mount_name" "$share_name" "$location" \
            && bashio::log.green "  $drive/$folder → $mount_name ($location)"

    done < <(jq -r 'keys[]' /tmp/mountit_folder_mounts.json 2>/dev/null)
fi
