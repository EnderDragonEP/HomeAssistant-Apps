#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Remove all registered CIFS mounts from HA Supervisor on shutdown
#
# This has to finish while smbd is still up. s6 stops ha-register before smbd,
# and Supervisor's DELETE synchronously unmounts the share on the host; if smbd
# goes away first the host kernel CIFS client wedges on EHOSTDOWN and the
# systemd mount unit only clears on reboot.
# ==============================================================================

# Only entries pointing at this addon's Samba server are Mount It's; never
# remove a user's own network storage that happens to share a drive's name.
# If the list cannot be read, fall back to removing by name so our shares are
# not left mounted on the host.
owned=$(curl -sS -m 10 \
    -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    "http://supervisor/mounts" 2>/dev/null \
    | jq -r --arg ip "$(cat /tmp/mountit_ip 2>/dev/null)" \
        'if .result == "ok" then [.data.mounts[]? | select(.server==$ip) | .name] else null end | @json' 2>/dev/null)
[[ -n "$owned" ]] || owned=null

deregister() {
    local name="$1" response
    [[ -z "$name" ]] && return

    if ! jq -e --arg n "$name" '. == null or any(.[]; . == $n)' <<< "$owned" > /dev/null; then
        bashio::log.info "  $name — not created by Mount It, leaving it alone"
        return
    fi

    response=$(curl -sS -m 15 -X DELETE \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        "http://supervisor/mounts/${name}" 2>/dev/null)

    if [[ "$(jq -r '.result // empty' <<< "$response")" == "ok" ]]; then
        bashio::log.info "  $name — removed"
    else
        bashio::log.warning "  $name — could not be removed (may already be gone)"
    fi
}

bashio::log.info "Deregistering drives from HA network storage..."

while IFS= read -r label; do
    deregister "$label"
done < <(jq -r 'keys[]' /tmp/mountit_mounts.json 2>/dev/null)

while IFS= read -r mount_name; do
    deregister "$mount_name"
done < <(jq -r 'keys[]' /tmp/mountit_folder_mounts.json 2>/dev/null)

bashio::log.info "HA deregistration complete"
