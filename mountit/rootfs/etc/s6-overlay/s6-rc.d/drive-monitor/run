#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Monitor for hot-plug drive events and mount/unmount automatically
# ==============================================================================
# shellcheck source=/dev/null
source /usr/lib/mountit/events.sh
# shellcheck source=/dev/null
source /usr/lib/mountit/mounts.sh

# Deliver startup events once Home Assistant Core is reachable, then announce
# what is mounted so automations can sync up after an addon or host restart.
(
    mountit::event.flush
    mountit::event.send ready "$(jq -nc \
        --slurpfile d /tmp/mountit_mounts.json \
        --slurpfile f /tmp/mountit_folder_mounts.json \
        '{"drives":($d[0] // {} | keys),"folder_mounts":($f[0] // {} | keys)}')" \
        || bashio::log.warning "Could not deliver event mountit_ready to Home Assistant"
) &

if ! bashio::config.true 'automount_on_plugin'; then
    bashio::log.info "Hot-plug disabled (automount_on_plugin=false)"
    exec sleep infinity
fi

bashio::log.blue "Hot-plug monitor active"

usage=$(bashio::config 'mount_location')
specific_label=$(bashio::config 'specific_label' 2>/dev/null || echo "")

mount_and_register() {
    local devname="$1"
    local fstype label mdisk options="nosuid,relatime" type="auto" cmd="mount"

    # Keep spaces inside the label so the name matches the one used at startup
    # ("My Drive" → My_Drive); a label of only spaces counts as unlabeled
    label=$(lsblk -dno LABEL "$devname" 2>/dev/null)
    [[ -z "${label//[[:space:]]/}" ]] && label=""
    fstype=$(lsblk "$devname" -no FSTYPE 2>/dev/null | tr -d '[:space:]')

    [[ -z "$fstype" ]] && return
    [[ "$label" == hassos* ]] && return

    if [[ -z "$label" ]]; then
        if ! bashio::config.true 'mount_unlabeled'; then
            bashio::log.info "Hot-plug: $devname has no label, skipping (mount_unlabeled=false)"
            return
        fi
        label="unlabeled_$(basename "$devname")"
        echo "$devname" > "/tmp/devmap_${label}"
    fi

    if [[ -n "$specific_label" && "$specific_label" != "null" && "$label" != "$specific_label" ]]; then
        bashio::log.info "Hot-plug: $devname ('$label') does not match specific_label, skipping"
        return
    fi

    # HA Supervisor mount names must match ^[A-Za-z0-9_]+$
    mdisk=$(printf '%s' "$label" | sed 's/[^A-Za-z0-9_]/_/g')

    if jq -e --arg k "$mdisk" '.[$k]' /tmp/mountit_mounts.json > /dev/null 2>&1; then
        return
    fi

    bashio::log.info "Hot-plug: $devname detected ($mdisk [$fstype])"

    mkdir -p "/mnt/$mdisk"
    chmod a+rwx "/mnt/$mdisk"

    local m_args=()
    case "$fstype" in
        exfat|vfat|msdos) options="${options},umask=000" ;;
        ntfs)              options="${options},umask=000"; type="ntfs3" ;;
        apfs)              cmd="mount.apfs"; type=""; options="" ;;
    esac
    [[ -n "$type" ]]    && m_args+=("-t" "$type")
    [[ -n "$options" ]] && m_args+=("-o" "$options")
    m_args+=("$devname")

    local mounted=false fix_out=""
    if $cmd "${m_args[@]}" "/mnt/$mdisk"; then
        mounted=true
    elif [[ "$fstype" == "ntfs" ]]; then
        # try clean up NTFS dirty state with ntfsfix
        bashio::log.warning "Hot-plug: $mdisk [ntfs] mount failed, running ntfsfix..."
        if fix_out=$(ntfsfix -d "$devname" 2>&1); then
            bashio::log.info "Hot-plug: $mdisk ntfsfix: ${fix_out//$'\n'/; }"
            bashio::log.warning "Hot-plug: $mdisk — NTFS dirty flag cleared without a full repair; if the drive was not safely ejected, verify data with chkdsk on Windows"
            mountit::event ntfs_repaired "$(jq -nc --arg n "$mdisk" --arg dev "$devname" \
                '{"name":$n,"device":$dev}')"
            $cmd "${m_args[@]}" "/mnt/$mdisk" && mounted=true
        else
            bashio::log.warning "Hot-plug: $mdisk ntfsfix failed: ${fix_out//$'\n'/; }"
        fi
    fi

    if ! $mounted; then
        bashio::log.error "Hot-plug: failed to mount $mdisk"
        rmdir "/mnt/$mdisk" 2>/dev/null || true
        mountit::event mount_failed "$(jq -nc --arg n "$mdisk" --arg dev "$devname" \
            --arg fs "$fstype" '{"name":$n,"device":$dev,"fstype":$fs,"source":"hotplug"}')"
        return
    fi

    jq --arg k "$mdisk" --arg dev "$devname" \
       --arg mp "/mnt/$mdisk" --arg fs "${fstype:-unknown}" \
       '. + {($k): {"device":$dev,"mount_point":$mp,"label":$k,"fstype":$fs}}' \
       /tmp/mountit_mounts.json > /tmp/mountit_mounts.json.tmp \
    && mv /tmp/mountit_mounts.json.tmp /tmp/mountit_mounts.json

    mountit::samba.add_share "$mdisk" "/mnt/$mdisk"
    smbcontrol smbd reload-config 2>/dev/null || true

    local registered=false
    if mountit::mount.register "$mdisk" "$mdisk" "$usage"; then
        registered=true
        bashio::log.green "Hot-plug: $mdisk mounted and registered"
    else
        bashio::log.warning "Hot-plug: $mdisk mounted but not added to HA network storage"
    fi

    # Bring back the folder mounts configured for this drive
    local name
    mountit::folders.setup "$mdisk"
    if [[ ${#MOUNTIT_NEW_FOLDERS[@]} -gt 0 ]]; then
        smbcontrol smbd reload-config 2>/dev/null || true
        for name in "${MOUNTIT_NEW_FOLDERS[@]}"; do
            mountit::mount.register "$name" \
                "$(jq -r --arg n "$name" '.[$n].share' /tmp/mountit_folder_mounts.json)" \
                "$(jq -r --arg n "$name" '.[$n].location' /tmp/mountit_folder_mounts.json)" \
                && bashio::log.green "Hot-plug: folder mount $name registered"
        done
    fi

    mountit::event drive_mounted "$(jq -nc --arg n "$mdisk" --arg dev "$devname" \
        --arg fs "${fstype:-unknown}" --arg mp "/mnt/$mdisk" --arg loc "$usage" \
        --argjson reg "$registered" \
        '{"name":$n,"device":$dev,"fstype":$fs,"mount_point":$mp,"location":$loc,"registered":$reg,"source":"hotplug"}')"
}

unmount_and_deregister() {
    local devname="$1"
    local mdisk

    mdisk=$(jq -r --arg dev "$devname" \
        'to_entries[] | select(.value.device==$dev) | .key' \
        /tmp/mountit_mounts.json 2>/dev/null | head -1)

    [[ -z "$mdisk" ]] && return

    bashio::log.info "Hot-plug: $devname removed ($mdisk)"

    # Folder mounts live on this drive, so they go first
    mountit::folders.teardown "$mdisk"
    mountit::mount.deregister "$mdisk"

    umount -l "/mnt/$mdisk" 2>/dev/null || true
    rmdir "/mnt/$mdisk" 2>/dev/null || true

    mountit::samba.remove_share "$mdisk"
    smbcontrol smbd reload-config 2>/dev/null || true

    jq --arg k "$mdisk" 'del(.[$k])' \
        /tmp/mountit_mounts.json > /tmp/mountit_mounts.json.tmp \
    && mv /tmp/mountit_mounts.json.tmp /tmp/mountit_mounts.json

    bashio::log.green "Hot-plug: $mdisk cleanly removed"
    mountit::event drive_removed "$(jq -nc --arg n "$mdisk" --arg dev "$devname" \
        '{"name":$n,"device":$dev}')"
}

# ---- Event loop ----
declare action="" devname="" devtype=""

udevadm monitor --subsystem-match=block --property --udev 2>/dev/null | \
while IFS='=' read -r key value; do
    value="${value%$'\r'}"
    case "$key" in
        ACTION)  action="$value" ;;
        DEVNAME) devname="$value" ;;
        DEVTYPE) devtype="$value" ;;
        "")
            if [[ "$devtype" == "partition" ]]; then
                case "$action" in
                    add)    sleep 2; mount_and_register "$devname" ;;
                    remove) unmount_and_deregister "$devname" ;;
                esac
            fi
            action=""; devname=""; devtype=""
            ;;
    esac
done
